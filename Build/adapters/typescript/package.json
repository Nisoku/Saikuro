{
  "name": "@nisoku/saikuro",
  "version": "0.1.0",
  "description": "TypeScript/JavaScript adapter for the Saikuro cross-language invocation fabric",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./schema-extractor": {
      "types": "./dist/schema_extractor.d.ts",
      "import": "./dist/schema_extractor.mjs",
      "require": "./dist/schema_extractor.js"
    }
  },
  "bin": {
    "saikuro-schema": "./dist/cli/saikuro-schema.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Nisoku/Saikuro"
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "schema": "node dist/cli/saikuro-schema.js",
    "format": "prettier --write . --ignore-path ../../../.gitignore",
    "format:check": "prettier --check . --ignore-path ../../../.gitignore"
  },
  "keywords": [
    "ipc",
    "cross-language",
    "saikuro",
    "rpc",
    "msgpack"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@msgpack/msgpack": "^3.0.0",
    "@nisoku/satori": "^0.1.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@types/node": "^26.6.1",
    "child_process": "^1.0.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "path": "^0.12.7",
    "prettier": "^3.9.7",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-x64": "^4.63.3"
  }
}
