MEMORY
{
  REGION_TEXT    : ORIGIN = 0x80000000, LENGTH = 3M
  REGION_RODATA  : ORIGIN = 0x80300000, LENGTH = 1M
  REGION_DATA    : ORIGIN = 0x80400000, LENGTH = 8K
  REGION_BSS     : ORIGIN = 0x80402000, LENGTH = 8K
  REGION_HEAP    : ORIGIN = 0x80404000, LENGTH = 256K
  REGION_STACK   : ORIGIN = 0x80444000, LENGTH = 16K
}
